<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 絕不宣告 android.permission.INTERNET，從根本上保證資料 100% Local-First -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotiStack">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NotificationListenerService 核心監聽服務 -->
        <service
            android:name=".service.LineNotificationListenerService"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 直接回覆廣播接收器 -->
        <receiver
            android:name=".service.ReplyActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.notistack.line.ACTION_DIRECT_REPLY" />
            </intent-filter>
        </receiver>

        <!-- 手動劃除通知廣播接收器 -->
        <receiver
            android:name=".service.NotificationDismissedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.notistack.line.ACTION_STACK_DISMISSED" />
            </intent-filter>
        </receiver>

        <!-- 點擊通知卡片廣播接收器 -->
        <receiver
            android:name=".service.NotificationClickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.notistack.line.ACTION_STACK_CLICKED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
